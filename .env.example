# ─────────────────────────────────────────────────────────────
#  vpn-to-proxy — пример конфигурации
#  Скопируй в .env и заполни:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Веб-панель ──────────────────────────────────────────────
# Порт и адрес, на котором слушает панель
PORT=8080
HOST=0.0.0.0

# ОБЯЗАТЕЛЬНО в проде. Мастер-ключ: подписывает сессии и шифрует секреты в БД
# (пароли прокси, содержимое подписок). Минимум 32 символа.
# Сгенерировать:  openssl rand -base64 48
# Если оставить пустым — ключ сгенерируется сам и ляжет в DATA_DIR/app-secret.
APP_SECRET=

# Учётка администратора, создаётся при первом запуске.
# Если ADMIN_PASSWORD пуст — пароль будет сгенерирован и напечатан в лог ОДИН РАЗ.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Время жизни сессии в часах (по умолчанию 30 дней)
SESSION_TTL_HOURS=720

# Включи, если панель стоит за nginx/traefik — тогда IP клиента берётся из X-Forwarded-For
TRUST_PROXY=false

# Требовать HTTPS для cookie сессии (включай, когда панель за TLS)
SECURE_COOKIES=false

# ── База данных ─────────────────────────────────────────────
# В docker-compose хост называется "mongo": mongodb://mongo:27017/vpn_to_proxy
MONGODB_URI=mongodb://127.0.0.1:27017/vpn_to_proxy

# ── Хранилище файлов ────────────────────────────────────────
# Каталог для конфигов sing-box, TLS-сертификатов и мастер-ключа
DATA_DIR=./data

# ── Ядро sing-box ───────────────────────────────────────────
# Путь до бинаря sing-box (в Docker-образе уже лежит в /usr/local/bin/sing-box)
SINGBOX_BIN=sing-box

# ── Прокси ──────────────────────────────────────────────────
# Хост/IP, который подставляется в выдаваемые строки прокси.
# Если пусто — панель попробует определить внешний IP автоматически.
PUBLIC_HOST=

# Адрес, на котором sing-box слушает прокси-порты.
# 0.0.0.0 — доступны снаружи; 127.0.0.1 — только локально.
PROXY_LISTEN=0.0.0.0

# Диапазон портов для прокси. Не забудь открыть его в фаерволе.
PROXY_PORT_START=20000
PROXY_PORT_END=29999

# ── Фоновые задачи ──────────────────────────────────────────
# Интервал автообновления подписок, минут (0 — выключить)
SUBSCRIPTION_REFRESH_MINUTES=360

# Интервал health-check прокси, минут (0 — выключить)
HEALTHCHECK_MINUTES=15

# URL, по которому проверяется работоспособность прокси и определяется внешний IP
HEALTHCHECK_URL=https://api.ipify.org?format=json
